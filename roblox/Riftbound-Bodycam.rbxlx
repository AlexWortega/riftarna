      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">SpellRules</string>
          <string name="Source"><![CDATA[-- A small Luau port of the browser prototype's elemental queue and spell selection.
local Rules = {}
Rules.MaxQueue = 2
Rules.Cooldown = {fire = 0.35, lightning = 0.85, stormfire = 1.25}
Rules.Range = {fire = 32, lightning = 58, stormfire = 47}
Rules.Damage = {fire = 32, lightning = 65, stormfire = 110}

function Rules.compile(queue)
	if type(queue) ~= "table" or #queue < 1 or #queue > Rules.MaxQueue then return nil end
	local fire, lightning = 0, 0
	for _, element in ipairs(queue) do
		if element == "fire" then fire += 1
		elseif element == "lightning" then lightning += 1
		else return nil end
	end
	if fire > 0 and lightning > 0 then return "stormfire" end
	if fire > 0 then return "fire" end
	return "lightning"
end

return Rules
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="4">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="5">
      <Properties>
        <string name="Name">Magic</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")
local Workspace = game:GetService("Workspace")

local shared = ReplicatedStorage:WaitForChild("Riftbound")
local Rules = require(shared:WaitForChild("SpellRules"))
local world = Workspace:WaitForChild("RiftboundWorld")
local flammables = world:WaitForChild("Flammables")
local targets = world:WaitForChild("Targets")
local remote = Instance.new("RemoteEvent")
remote.Name = "SpellEvent"
remote.Parent = shared

local lastCast = {}
local burning = {}

local function rootOfHit(instance)
	local current = instance
	while current and current ~= world do
		if current:IsA("Model") and (current.Parent == flammables or current.Parent == targets) then return current end
		current = current.Parent
	end
	return nil
end

local function center(model)
	if model.PrimaryPart then return model.PrimaryPart.Position end
	return model:GetPivot().Position
end

local function addFire(model)
	if burning[model] or model:GetAttribute("Destroyed") then return end
	if not model.PrimaryPart then return end
	local isHut = model.Name:match("Hut") ~= nil
	local offsets = isHut and {Vector3.new(0, 6, 8.9), Vector3.new(0, 15.5, 0)} or {Vector3.new(0, model.Name:match("Pine") and 8 or 2, 0)}
	local anchors = {}
	for index, offset in ipairs(offsets) do
		local anchor = Instance.new("Part")
		anchor.Name = "Burning source"
		anchor.Size = Vector3.new(0.2, 0.2, 0.2)
		anchor.Transparency = 1
		anchor.Anchored, anchor.CanCollide, anchor.CanQuery = true, false, false
		anchor.Position = center(model) + offset
		anchor.Parent = model
		local flame = Instance.new("Fire")
		flame.Name = "RiftboundFire"
		flame.Color = Color3.fromRGB(255, 108, 34)
		flame.SecondaryColor = Color3.fromRGB(255, 197, 71)
		flame.Heat = 7
		flame.Size = isHut and (index == 1 and 7 or 9) or 5
		flame.Parent = anchor
		if index == #offsets then
			local smoke = Instance.new("Smoke")
			smoke.Name = "RiftboundSmoke"
			smoke.Color = Color3.fromRGB(33, 31, 30)
			smoke.Opacity = 0.42
			smoke.RiseVelocity = 7
			smoke.Size = 9
			smoke.Parent = anchor
		end
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 107, 49)
		light.Brightness, light.Range = 2.2, 20
		light.Parent = anchor
		table.insert(anchors, anchor)
	end
	burning[model] = {age = 0, anchors = anchors}
	remote:FireAllClients("ignite", center(model))
end

local function destroyModel(model)
	if model:GetAttribute("Destroyed") then return end
	model:SetAttribute("Destroyed", true)
	local state = burning[model]
	if state then
		for _, anchor in ipairs(state.anchors) do anchor:Destroy() end
		burning[model] = nil
	end
	local pos = center(model)
	remote:FireAllClients("collapse", pos)
	local count = 0
	for _, child in ipairs(model:GetDescendants()) do
		if child:IsA("BasePart") then
			if child:GetAttribute("Roof") or model.Parent == targets or model.Name:match("Fence") then
				child.Anchored = false
				child.CanCollide = true
				child.AssemblyLinearVelocity = Vector3.new(math.random(-15, 15), math.random(7, 19), math.random(-15, 15))
				Debris:AddItem(child, 7)
				count += 1
			elseif child.Name ~= "Stone foundation" then
				child.Color = Color3.fromRGB(43, 38, 35)
				child.Material = Enum.Material.Slate
			end
		end
		if count >= 14 then break end
	end
	if model.Parent == targets or model.Name:match("Fence") then Debris:AddItem(model, 8) end
end

local function damage(model, amount, element)
	if not model or model:GetAttribute("Destroyed") then return end
	local hp = (model:GetAttribute("Health") or 100) - amount
	model:SetAttribute("Health", hp)
	if element == "fire" or element == "stormfire" then
		if model.Parent == flammables then addFire(model) end
	end
	if hp <= 0 then destroyModel(model) end
end

local function withinBlast(position, radius, callback)
	for _, folder in ipairs({flammables, targets}) do
		for _, model in ipairs(folder:GetChildren()) do
			if model:IsA("Model") and not model:GetAttribute("Destroyed") and (center(model) - position).Magnitude <= radius then callback(model) end
		end
	end
end

remote.OnServerEvent:Connect(function(player, action, queue, aim)
	if action ~= "cast" or type(aim) ~= "table" or typeof(aim.x) ~= "number" or typeof(aim.y) ~= "number" or typeof(aim.z) ~= "number" then return end
	if aim.x ~= aim.x or aim.y ~= aim.y or aim.z ~= aim.z then return end
	local spell = Rules.compile(queue)
	if not spell then return end
	local now = os.clock()
	if now - (lastCast[player] or -100) < Rules.Cooldown[spell] then return end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local head = character and character:FindFirstChild("Head")
	if not head or not humanoid or humanoid.Health <= 0 then return end
	local direction = Vector3.new(aim.x, aim.y, aim.z)
	if direction.Magnitude < 0.9 or direction.Magnitude > 1.1 then return end
	direction = direction.Unit
	lastCast[player] = now
	local origin = head.Position + direction * 1.2
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = {character}
	local hit = Workspace:Raycast(origin, direction * Rules.Range[spell], rayParams)
	local position = hit and hit.Position or origin + direction * Rules.Range[spell]
	local directModel = hit and rootOfHit(hit.Instance) or nil
	if spell == "fire" then
		if directModel then damage(directModel, Rules.Damage.fire, "fire") end
		withinBlast(position, 8, function(model)
			if model ~= directModel then damage(model, Rules.Damage.fire, "fire") end
		end)
	elseif spell == "lightning" then
		if directModel then damage(directModel, Rules.Damage.lightning, "lightning") end
	else
		if directModel then damage(directModel, Rules.Damage.stormfire, "stormfire") end
		withinBlast(position, 13, function(model)
			if model ~= directModel then damage(model, Rules.Damage.stormfire, "stormfire") end
		end)
	end
	remote:FireAllClients("cast", {spell = spell, origin = origin, position = position, caster = player.UserId})
end)

Players.PlayerRemoving:Connect(function(player) lastCast[player] = nil end)

task.spawn(function()
	while true do
		task.wait(0.5)
		for model, state in pairs(burning) do
			if model.Parent and not model:GetAttribute("Destroyed") then
				state.age += 0.5
				local scorch = math.clamp(state.age / 11, 0, 0.75)
				for _, p in ipairs(model:GetDescendants()) do
					if p:IsA("BasePart") and p.Name ~= "Stone foundation" then p.Color = p.Color:Lerp(Color3.fromRGB(38, 34, 31), scorch * 0.07) end
				end
				if state.age > 2 then
					withinBlast(center(model), 15, function(other)
						if other ~= model and other.Parent == flammables and not burning[other] and math.random() < 0.13 then addFire(other) end
					end)
				end
				if state.age >= 11 then destroyModel(model) end
			else burning[model] = nil end
		end
	end
end)
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="6">
      <Properties>
        <string name="Name">World</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[-- Everything needed for a walkable scene is embedded in the place. The optional
-- Kenney FBX kit can replace these models after import in Roblox Studio.
local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")

local old = Workspace:FindFirstChild("RiftboundWorld")
if old then old:Destroy() end
local baseplate = Workspace:FindFirstChild("Baseplate")
if baseplate then baseplate:Destroy() end
local defaultSpawn = Workspace:FindFirstChild("SpawnLocation")
if defaultSpawn then defaultSpawn:Destroy() end
local world = Instance.new("Folder")
world.Name = "RiftboundWorld"
world.Parent = Workspace

local function part(parent, name, size, cf, material, color, anchored)
	local p = Instance.new("Part")
	p.Name, p.Size, p.CFrame = name, size, cf
	p.Material, p.Color = material, color
	p.Anchored = anchored ~= false
	p.TopSurface, p.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local timber = Color3.fromRGB(83, 64, 47)
local plaster = Color3.fromRGB(169, 153, 126)
local straw = Color3.fromRGB(164, 137, 91)
local stone = Color3.fromRGB(90, 87, 78)

part(world, "Ground", Vector3.new(280, 2, 260), CFrame.new(0, -1, 0), Enum.Material.Ground, Color3.fromRGB(51, 57, 44))
part(world, "Village road", Vector3.new(20, 0.12, 180), CFrame.new(0, 0.07, -25), Enum.Material.Ground, Color3.fromRGB(105, 86, 60))
local strawRandom = Random.new(417)
for i = 1, 620 do
	local x = strawRandom:NextNumber(-10, 10)
	local z = strawRandom:NextNumber(-112, 63)
	local length = strawRandom:NextNumber(0.45, 1.6)
	local tint = strawRandom:NextInteger(-17, 17)
	local strand = part(world, "Loose straw", Vector3.new(0.055, 0.025, length), CFrame.new(x, 0.151, z) * CFrame.Angles(0, strawRandom:NextNumber(-math.pi, math.pi), 0), Enum.Material.Grass, Color3.fromRGB(153 + tint, 127 + tint, 75 + tint))
	strand.CanCollide, strand.CanTouch, strand.CanQuery = false, false, false
end
for i = 1, 105 do
	local z = 70 - i * 2.1
	local side = i % 2 == 0 and -1 or 1
	local x = side * (9.5 + (i % 6) * 1.1)
	local verge = part(world, "Straw and mud verge", Vector3.new(0.6 + (i % 4) * 0.3, 0.04, 0.8 + (i % 5) * 0.5), CFrame.new(x, 0.12, z) * CFrame.Angles(0, i * 2.4, 0), Enum.Material.Grass, Color3.fromRGB(85 + (i % 3) * 8, 79 + (i % 4) * 5, 52))
	verge.CanCollide = false
end
local flammables = Instance.new("Folder")
flammables.Name = "Flammables"
flammables.Parent = world
local targets = Instance.new("Folder")
targets.Name = "Targets"
targets.Parent = world

-- Winter silhouettes beyond the huts keep the misty village from looking like a flat tree line.
local function bareBranch(parent, from, to, width)
	local span = to - from
	local branch = part(parent, "Bare branch", Vector3.new(width, span.Magnitude, width), CFrame.lookAt((from + to) / 2, to) * CFrame.Angles(math.rad(90), 0, 0), Enum.Material.Wood, Color3.fromRGB(68, 65, 59))
	branch.CanCollide = false
end
for i = 1, 14 do
	local z = 82 - i * 13
	local x = (i % 2 == 0 and 1 or -1) * (46 + (i % 4) * 6)
	local deadTree = Instance.new("Model")
	deadTree.Name = "Bare tree " .. i
	deadTree:SetAttribute("Flammable", true)
	deadTree:SetAttribute("Health", 55)
	deadTree.Parent = flammables
	local trunk = part(deadTree, "Trunk", Vector3.new(1.1, 14, 1.1), CFrame.new(x, 7, z), Enum.Material.Wood, Color3.fromRGB(68, 65, 59))
	deadTree.PrimaryPart = trunk
	for level = 1, 5 do
		for side = -1, 1, 2 do
			local start = Vector3.new(x, 4 + level * 2.1, z)
			local tip = start + Vector3.new(side * (4.8 - level * 0.35), 3.3 + level * 0.15, ((i + level) % 3 - 1) * 2.2)
			bareBranch(deadTree, start, tip, 0.5 - level * 0.055)
			bareBranch(deadTree, tip, tip + Vector3.new(side * 1.4, 2.2, 0.8), 0.15)
		end
	end
end

local artKit = ServerStorage:FindFirstChild("RiftboundArt")
local function placeArt(name, cf, parent)
	local template = artKit and artKit:FindFirstChild(name)
	if not template then return nil end
	local clone = template:Clone()
	if clone:IsA("BasePart") then
		clone.CFrame = cf
		clone.Anchored = true
	elseif clone:IsA("Model") then
		clone:PivotTo(cf)
		if not clone.PrimaryPart then clone.PrimaryPart = clone:FindFirstChildWhichIsA("BasePart", true) end
		for _, item in ipairs(clone:GetDescendants()) do
			if item:IsA("BasePart") then item.Anchored = true end
		end
	else
		clone:Destroy()
		return nil
	end
	clone.Name = name
	clone.Parent = parent
	return clone
end

local function hut(x, z, side, index)
	local model = Instance.new("Model")
	model.Name = "Hut " .. index
	model:SetAttribute("Flammable", true)
	model:SetAttribute("Health", 140)
	model.Parent = flammables
	local w, d = 18, 16
	part(model, "Stone foundation", Vector3.new(w + 1, 1.2, d + 1), CFrame.new(x, 0.6, z), Enum.Material.Cobblestone, stone)
	part(model, "Rear wall", Vector3.new(w, 9, 1), CFrame.new(x, 5.5, z - d / 2), Enum.Material.Sandstone, plaster)
	part(model, "Front wall", Vector3.new(w, 9, 1), CFrame.new(x, 5.5, z + d / 2), Enum.Material.Sandstone, plaster)
	for _, dx in ipairs({-w / 2, w / 2}) do
		part(model, "Side wall", Vector3.new(1, 9, d), CFrame.new(x + dx, 5.5, z), Enum.Material.Sandstone, plaster)
	end
	for _, dx in ipairs({-w / 2 + 0.7, w / 2 - 0.7}) do
		for _, dz in ipairs({-d / 2 + 0.7, d / 2 - 0.7}) do
			part(model, "Wood post", Vector3.new(0.9, 10.5, 0.9), CFrame.new(x + dx, 5.8, z + dz), Enum.Material.Wood, timber)
		end
	end
	for _, dx in ipairs({-6, 0, 6}) do
		part(model, "Timber frame", Vector3.new(0.55, 8.5, 0.48), CFrame.new(x + dx, 5.4, z + d / 2 + 0.55), Enum.Material.Wood, timber)
	end
	for _, dy in ipairs({2.6, 8.8}) do
		part(model, "Timber beam", Vector3.new(w, 0.55, 0.5), CFrame.new(x, dy, z + d / 2 + 0.55), Enum.Material.Wood, timber)
	end
	for _, dx in ipairs({-4.5, 4.5}) do
		part(model, "Cross brace", Vector3.new(0.44, 5.2, 0.5), CFrame.new(x + dx, 5.7, z + d / 2 + 0.72) * CFrame.Angles(0, 0, math.rad(dx > 0 and 30 or -30)), Enum.Material.Wood, timber)
	end
	for _, ridgeSide in ipairs({-1, 1}) do
		local edge = Vector3.new(x + ridgeSide * (w / 2 + 1), 9.6, z)
		local ridge = Vector3.new(x, 14.8, z)
		local center = (edge + ridge) / 2
		local roof = part(model, "Thatch roof", Vector3.new(12, 0.8, d + 3), CFrame.new(center) * CFrame.Angles(0, 0, -ridgeSide * math.rad(30)), Enum.Material.Ground, straw)
		roof:SetAttribute("Roof", true)
		for j = 1, 12 do
			local fringe = part(model, "Hanging thatch", Vector3.new(0.22, 0.7 + (j % 3) * 0.18, 0.9), CFrame.new(x + ridgeSide * (w / 2 + 1.5), 9.25, z - d / 2 - 1 + j * 1.45), Enum.Material.Grass, Color3.fromRGB(132 + j % 3 * 6, 113 + j % 4 * 4, 68))
			fringe.CanCollide = false
		end
	end
	local door = part(model, "Door", Vector3.new(3.8, 6, 0.3), CFrame.new(x - side * 4, 4, z + d / 2 + 0.4), Enum.Material.WoodPlanks, timber)
	door.CanCollide = false
	part(model, "Door iron", Vector3.new(3.9, 0.2, 0.15), CFrame.new(x - side * 4, 5.2, z + d / 2 + 0.65), Enum.Material.Metal, Color3.fromRGB(48, 47, 43))
	part(model, "Door handle", Vector3.new(0.25, 0.35, 0.25), CFrame.new(x - side * 4 + 1.15, 3.7, z + d / 2 + 0.72), Enum.Material.Metal, Color3.fromRGB(89, 77, 54))
	for j = 1, 3 do
		part(model, "Window", Vector3.new(1.7, 2, 0.2), CFrame.new(x + j * 3 - 7, 6, z + d / 2 + 0.6), Enum.Material.Glass, Color3.fromRGB(41, 37, 28)).Transparency = 0.25
	end
	model.PrimaryPart = model:FindFirstChild("Stone foundation")
	for j = 1, 5 do
		local stack = part(model, "Firewood", Vector3.new(0.8, 0.8, 4.2), CFrame.new(x + (j - 3) * 0.85, 1.1 + (j % 2) * 0.45, z + d / 2 + 1.6), Enum.Material.Wood, Color3.fromRGB(75 + j * 3, 54 + j * 2, 39))
		stack.Shape = Enum.PartType.Cylinder
	end
	for j = 1, 2 do
		local barrel = part(model, "Barrel", Vector3.new(2.3, 2.8, 2.3), CFrame.new(x + (j == 1 and -7 or 7), 1.4, z + d / 2 + 3.6), Enum.Material.WoodPlanks, Color3.fromRGB(83, 62, 42))
		barrel.Shape = Enum.PartType.Cylinder
	end
	return model
end

local function fence(x, z, length, index)
	local imported = placeArt("Fence", CFrame.new(x, 0, z + length * 1.5), flammables)
	if imported then
		local model = imported
		if imported:IsA("BasePart") then
			model = Instance.new("Model")
			model.Name = "Fence " .. index
			imported.Parent = model
			model.PrimaryPart = imported
			model.Parent = flammables
		else model.Name = "Fence " .. index end
		model:SetAttribute("Flammable", true)
		model:SetAttribute("Health", 55)
		return model
	end
	local model = Instance.new("Model")
	model.Name = "Fence " .. index
	model:SetAttribute("Flammable", true)
	model:SetAttribute("Health", 55)
	model.Parent = flammables
	for j = 0, length do
		part(model, "Fence post", Vector3.new(0.8, 3.5, 0.8), CFrame.new(x, 1.75, z + j * 3), Enum.Material.Wood, timber)
	end
	for _, y in ipairs({1.3, 2.7}) do
		part(model, "Fence rail", Vector3.new(0.35, 0.35, length * 3), CFrame.new(x, y, z + length * 1.5), Enum.Material.Wood, timber)
	end
	model.PrimaryPart = model:FindFirstChild("Fence post")
	return model
end

for i = 1, 8 do
	local z = 46 - (i - 1) * 23
	hut(i % 2 == 0 and 23 or -23, z, i % 2 == 0 and 1 or -1, i)
	fence(i % 2 == 0 and 12 or -12, z - 6, 4, i)
end
for i, z in ipairs({35, -12, -64}) do
	placeArt("Cart", CFrame.new(i % 2 == 0 and 14 or -14, 0, z) * CFrame.Angles(0, math.rad(i * 31), 0), world)
end
for _, z in ipairs({46, -23, -92}) do
	placeArt("Lantern", CFrame.new(8, 4, z), world)
end

for i = 1, 38 do
	local z = 85 - i * 5.5
	local x = (i % 2 == 0 and 1 or -1) * (36 + (i % 7) * 4)
	local tree = Instance.new("Model")
	tree.Name = "Pine " .. i
	tree:SetAttribute("Flammable", true)
	tree:SetAttribute("Health", 65)
	tree.Parent = flammables
	part(tree, "Trunk", Vector3.new(1.4, 9, 1.4), CFrame.new(x, 4.5, z), Enum.Material.Wood, timber)
	for level = 1, 4 do
		for branch = 1, 5 do
			local angle = branch * math.pi * 2 / 5 + level * 0.4
			local radius = (5 - level) * 0.8
			local leaf = part(tree, "Needles", Vector3.new(3.8, 3.6, 5.4), CFrame.new(x + math.cos(angle) * radius, 5 + level * 2.4, z + math.sin(angle) * radius) * CFrame.Angles(0, angle, math.rad(18)), Enum.Material.LeafyGrass, Color3.fromRGB(38 + level * 2, 55 + level * 3, 43))
			leaf.Shape = Enum.PartType.Ball
		end
	end
	tree.PrimaryPart = tree:FindFirstChild("Trunk")
end

for i = 1, 4 do
	local z = 18 - i * 34
	local target = Instance.new("Model")
	target.Name = "Training raider " .. i
	target:SetAttribute("Health", 220)
	target.Parent = targets
	local x = i % 2 == 0 and 4 or -4
	part(target, "Body", Vector3.new(2.6, 3.6, 1.7), CFrame.new(x, 3.1, z), Enum.Material.Fabric, Color3.fromRGB(104, 28, 39))
	part(target, "Head", Vector3.new(1.4, 1.4, 1.4), CFrame.new(x, 5.4, z), Enum.Material.SmoothPlastic, Color3.fromRGB(124, 104, 85)).Shape = Enum.PartType.Ball
	local hood = part(target, "Red hood", Vector3.new(2.3, 2.2, 2.3), CFrame.new(x, 6.1, z), Enum.Material.Fabric, Color3.fromRGB(112, 28, 39))
	hood.Shape = Enum.PartType.Ball
	local point = part(target, "Hood tip", Vector3.new(1.2, 1.8, 1.2), CFrame.new(x, 7.25, z - 0.35), Enum.Material.Fabric, Color3.fromRGB(112, 28, 39))
	point.Shape = Enum.PartType.Ball
	for _, side in ipairs({-1, 1}) do
		part(target, "Arm", Vector3.new(0.8, 2.8, 0.8), CFrame.new(x + side * 1.7, 3.2, z), Enum.Material.Fabric, Color3.fromRGB(88, 29, 39))
		part(target, "Leg", Vector3.new(0.8, 2.7, 0.8), CFrame.new(x + side * 0.65, 1.4, z), Enum.Material.Fabric, Color3.fromRGB(55, 43, 43))
	end
	target.PrimaryPart = target:FindFirstChild("Body")
end

local spawn = Instance.new("SpawnLocation")
spawn.Name = "VillageSpawn"
spawn.Size = Vector3.new(7, 0.5, 7)
spawn.CFrame = CFrame.new(0, 0.3, 66)
spawn.Transparency = 1
spawn.Anchored = true
spawn.Neutral = true
spawn.Parent = world

Lighting.Ambient = Color3.fromRGB(158, 165, 166)
Lighting.OutdoorAmbient = Color3.fromRGB(176, 180, 181)
Lighting.ClockTime = 11.2
Lighting.Brightness = 1.75
Lighting.ExposureCompensation = 0.12
Lighting.ShadowSoftness = 0.72
Lighting.FogColor = Color3.fromRGB(128, 135, 137)
Lighting.FogStart = 45
Lighting.FogEnd = 205
local atmosphere = Instance.new("Atmosphere")
atmosphere.Density = 0.48
atmosphere.Haze = 2.5
atmosphere.Color = Color3.fromRGB(186, 190, 187)
atmosphere.Decay = Color3.fromRGB(113, 122, 128)
atmosphere.Parent = Lighting
local clouds = Instance.new("Clouds")
clouds.Cover = 0.9
clouds.Density = 0.85
clouds.Color = Color3.fromRGB(170, 175, 172)
clouds.Parent = Workspace.Terrain
local colorCorrection = Instance.new("ColorCorrectionEffect")
colorCorrection.Contrast = 0.13
colorCorrection.Saturation = -0.19
colorCorrection.TintColor = Color3.fromRGB(227, 232, 228)
colorCorrection.Parent = Lighting

local function preparePlayer(player)
	player.CharacterAdded:Connect(function(character)
		local humanoid = character:WaitForChild("Humanoid")
		humanoid.WalkSpeed = 15
		humanoid.JumpPower = 0
		character:WaitForChild("HumanoidRootPart").CFrame = CFrame.new(0, 4, 66)
	end)
end
Players.PlayerAdded:Connect(preparePlayer)
for _, player in ipairs(Players:GetPlayers()) do preparePlayer(player) end
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="7">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="8">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="9">
        <Properties>
          <string name="Name">Bodycam</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local player = Players.LocalPlayer
local shared = ReplicatedStorage:WaitForChild("Riftbound")
local Rules = require(shared:WaitForChild("SpellRules"))
local remote = shared:WaitForChild("SpellEvent")
local camera = workspace.CurrentCamera
local queue = {}
local held = {}
local yaw, pitch, stride, castKick = 0, 0, 0, 0
local character, humanoid, root, head
local lastLocalCast = 0
local fx = Instance.new("Folder")
fx.Name = "RiftboundLocalFX"
fx.Parent = workspace

local gui = Instance.new("ScreenGui")
gui.Name = "RiftboundHUD"
gui.IgnoreGuiInset = true
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local function label(name, text, size, position, anchor, color, font)
	local t = Instance.new("TextLabel")
	t.Name, t.Text, t.Size, t.Position, t.AnchorPoint = name, text, size, position, anchor
	t.BackgroundTransparency = 1
	t.TextColor3 = color
	t.TextStrokeTransparency = 0.55
	t.TextStrokeColor3 = Color3.new(0, 0, 0)
	t.Font = font or Enum.Font.Code
	t.TextScaled = true
	t.Parent = gui
	return t
end

local white = Color3.fromRGB(229, 236, 234)
local title = label("Bodycam", "RIFTBOUND // VILLAGE 01", UDim2.fromOffset(270, 20), UDim2.fromOffset(205, 22), Vector2.new(0, 0), white)
title.TextXAlignment = Enum.TextXAlignment.Left
local clock = label("Clock", "● REC", UDim2.fromOffset(310, 26), UDim2.new(1, -25, 0, 18), Vector2.new(1, 0), white)
clock.TextXAlignment = Enum.TextXAlignment.Right
local crosshair = label("Crosshair", "+", UDim2.fromOffset(18, 18), UDim2.fromScale(0.5, 0.5), Vector2.new(0.5, 0.5), white)
crosshair.TextTransparency = 0.25
local spellName = label("Spell", "ЗАКЛИНАНИЕ НЕ СОБРАНО", UDim2.fromOffset(350, 28), UDim2.new(0.5, 0, 1, -82), Vector2.new(0.5, 1), white)
local controls = label("Controls", "WASD — ДВИЖЕНИЕ   SHIFT — БЕГ   Q — ОГОНЬ   E — МОЛНИЯ   ЛКМ/F — КАСТ   C — ОЧИСТИТЬ", UDim2.new(0.75, 0, 0, 23), UDim2.new(0.5, 0, 1, -16), Vector2.new(0.5, 1), white)
controls.TextTransparency = 0.2
local hitFlash = Instance.new("Frame")
hitFlash.Size = UDim2.fromScale(1, 1)
hitFlash.BackgroundColor3 = Color3.fromRGB(255, 111, 46)
hitFlash.BackgroundTransparency = 1
hitFlash.BorderSizePixel = 0
hitFlash.Parent = gui
hitFlash.ZIndex = 0
local vignette = Instance.new("Frame")
vignette.Size = UDim2.fromScale(1, 1)
vignette.BackgroundTransparency = 1
vignette.Parent = gui
local gradient = Instance.new("UIGradient")
gradient.Rotation = 90
gradient.Transparency = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.65), NumberSequenceKeypoint.new(0.2, 1), NumberSequenceKeypoint.new(0.8, 1), NumberSequenceKeypoint.new(1, 0.55)})
gradient.Parent = vignette
vignette.BackgroundColor3 = Color3.fromRGB(9, 10, 10)
vignette.BackgroundTransparency = 0.65

local function makeViewPart(name, size, material, color)
	local p = Instance.new("Part")
	p.Name, p.Size, p.Material, p.Color = name, size, material, color
	p.Anchored, p.CanCollide, p.CanQuery, p.CastShadow = true, false, false, false
	p.Parent = camera
	return p
end
local leftArm = makeViewPart("Left sleeve", Vector3.new(0.48, 1.1, 0.5), Enum.Material.Fabric, Color3.fromRGB(38, 65, 105))
local rightArm = makeViewPart("Right sleeve", Vector3.new(0.48, 1.1, 0.5), Enum.Material.Fabric, Color3.fromRGB(38, 65, 105))
local skin = Color3.fromRGB(174, 137, 111)
local leftHand = makeViewPart("Open palm", Vector3.new(0.5, 0.55, 0.24), Enum.Material.SmoothPlastic, skin)
leftHand.Shape = Enum.PartType.Ball
local rightHand = makeViewPart("Grip", Vector3.new(0.43, 0.49, 0.31), Enum.Material.SmoothPlastic, skin)
rightHand.Shape = Enum.PartType.Ball
local staff = makeViewPart("Charred staff", Vector3.new(0.17, 0.17, 2.3), Enum.Material.Wood, Color3.fromRGB(54, 41, 32))
local staffTip = makeViewPart("Staff ember", Vector3.new(0.32, 0.32, 0.32), Enum.Material.Neon, Color3.fromRGB(243, 110, 53))
staffTip.Shape = Enum.PartType.Ball
local viewParts = {leftArm, rightArm, leftHand, rightHand, staff, staffTip}

local function refreshSpell()
	local spell = Rules.compile(queue)
	if spell == "fire" then spellName.Text = "ОГНЕННЫЙ ПОТОК  ·  ЛКМ"; spellName.TextColor3 = Color3.fromRGB(255, 158, 91)
	elseif spell == "lightning" then spellName.Text = "ЦЕПНАЯ МОЛНИЯ  ·  ЛКМ"; spellName.TextColor3 = Color3.fromRGB(177, 151, 255)
	elseif spell == "stormfire" then spellName.Text = "ГРОЗОВОЙ ОГОНЬ  ·  ЛКМ"; spellName.TextColor3 = Color3.fromRGB(255, 207, 143)
	else spellName.Text = "Q ОГОНЬ    E МОЛНИЯ    Q + E КОМБИНАЦИЯ"; spellName.TextColor3 = white end
end
refreshSpell()

local function castSelection()
	if not root then return end
	local spell = Rules.compile(queue)
	local now = os.clock()
	if spell and now - lastLocalCast >= Rules.Cooldown[spell] then
		lastLocalCast = now
		remote:FireServer("cast", table.clone(queue), {x = camera.CFrame.LookVector.X, y = camera.CFrame.LookVector.Y, z = camera.CFrame.LookVector.Z})
		table.clear(queue)
		refreshSpell()
	end
end

local function beam(a, b, color, width, life)
	local delta = b - a
	if delta.Magnitude < 0.05 then return end
	local p = Instance.new("Part")
	p.Name = "Spell trail"
	p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery = true, false, false, false
	p.Material, p.Color = Enum.Material.Neon, color
	p.Size = Vector3.new(width, width, delta.Magnitude)
	p.CFrame = CFrame.lookAt((a + b) / 2, b)
	p.Parent = fx
	TweenService:Create(p, TweenInfo.new(life), {Transparency = 1, Size = Vector3.new(width * 0.2, width * 0.2, delta.Magnitude)}):Play()
	Debris:AddItem(p, life + 0.1)
end

local function burst(position, color, count, radius)
	local source = Instance.new("Part")
	source.Name = "Spell sparks"
	source.Anchored, source.CanCollide, source.CanQuery = true, false, false
	source.Transparency = 1
	source.Size = Vector3.new(0.2, 0.2, 0.2)
	source.Position = position
	source.Parent = fx
	local emitter = Instance.new("ParticleEmitter")
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 0.7
	emitter.Lifetime = NumberRange.new(0.25, 0.75)
	emitter.Speed = NumberRange.new(radius * 1.5, radius * 3)
	emitter.SpreadAngle = Vector2.new(180, 180)
	emitter.Size = NumberSequence.new({NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(1, 0)})
	emitter.Rate = 0
	emitter.Parent = source
	emitter:Emit(count)
	local light = Instance.new("PointLight")
	light.Color, light.Brightness, light.Range = color, 3, radius * 3
	light.Parent = source
	TweenService:Create(light, TweenInfo.new(0.35), {Brightness = 0}):Play()
	Debris:AddItem(source, 1.1)
end

local function scorch(position, size)
	local mark = Instance.new("Part")
	mark.Name = "Scorched ground"
	mark.Shape = Enum.PartType.Cylinder
	mark.Size = Vector3.new(0.035, size, size)
	mark.CFrame = CFrame.new(position + Vector3.new(0, 0.07, 0)) * CFrame.Angles(0, 0, math.pi / 2)
	mark.Material = Enum.Material.Slate
	mark.Color = Color3.fromRGB(34, 30, 28)
	mark.Transparency = 0.22
	mark.Anchored, mark.CanCollide, mark.CanQuery = true, false, false
	mark.Parent = fx
	TweenService:Create(mark, TweenInfo.new(15), {Transparency = 1}):Play()
	Debris:AddItem(mark, 15.1)
end

local function showCast(event)
	local origin, target = event.origin, event.position
	if typeof(origin) ~= "Vector3" or typeof(target) ~= "Vector3" then return end
	local spell = event.spell
	if spell == "fire" then
		local length = math.min((target - origin).Magnitude, 32)
		local direction = (target - origin).Unit
		for i = 1, 9 do
			local at = origin + direction * (length * i / 9)
			burst(at, i % 2 == 0 and Color3.fromRGB(255, 99, 31) or Color3.fromRGB(255, 183, 62), 3, 2)
		end
		beam(origin, target, Color3.fromRGB(255, 120, 46), 0.3, 0.23)
		scorch(target, 5)
	elseif spell == "lightning" then
		local previous = origin
		for i = 1, 9 do
			local at = origin:Lerp(target, i / 9)
			if i < 9 then at += Vector3.new(math.random(-3, 3) * 0.35, math.random(-3, 3) * 0.35, math.random(-3, 3) * 0.35) end
		beam(previous, at, Color3.fromRGB(176, 155, 255), 0.28, 0.17)
		beam(previous, at, Color3.fromRGB(240, 235, 255), 0.07, 0.12)
		previous = at
		end
		burst(target, Color3.fromRGB(171, 144, 255), 22, 5)
	else
		beam(origin, target, Color3.fromRGB(205, 166, 255), 0.36, 0.28)
		burst(target, Color3.fromRGB(255, 119, 44), 55, 10)
		burst(target, Color3.fromRGB(168, 137, 255), 30, 12)
		scorch(target, 12)
	end
	if event.caster == player.UserId then
		castKick = 1
		hitFlash.BackgroundColor3 = spell == "lightning" and Color3.fromRGB(175, 151, 255) or Color3.fromRGB(255, 111, 46)
		hitFlash.BackgroundTransparency = 0.95
		TweenService:Create(hitFlash, TweenInfo.new(0.28), {BackgroundTransparency = 1}):Play()
	end
end

remote.OnClientEvent:Connect(function(kind, payload)
	if kind == "cast" and type(payload) == "table" then showCast(payload)
	elseif kind == "ignite" and typeof(payload) == "Vector3" then burst(payload + Vector3.new(0, 5, 0), Color3.fromRGB(255, 109, 42), 26, 7)
	elseif kind == "collapse" and typeof(payload) == "Vector3" then burst(payload + Vector3.new(0, 5, 0), Color3.fromRGB(91, 83, 75), 32, 9) end
end)

local function attachCharacter(newCharacter)
	character = newCharacter
	humanoid = character:WaitForChild("Humanoid")
	root = character:WaitForChild("HumanoidRootPart")
	head = character:WaitForChild("Head")
	yaw = math.rad(root.Orientation.Y)
	for _, descendant in ipairs(character:GetDescendants()) do
		if descendant:IsA("BasePart") then descendant.LocalTransparencyModifier = 1 end
	end
	character.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("BasePart") then descendant.LocalTransparencyModifier = 1 end
	end)
	humanoid.AutoRotate = false
	humanoid.WalkSpeed = 15
	humanoid.JumpPower = 0
end
if player.Character then task.spawn(attachCharacter, player.Character) end
player.CharacterAdded:Connect(attachCharacter)

UserInputService.InputBegan:Connect(function(input, processed)
	if processed or UserInputService:GetFocusedTextBox() then return end
	local key = input.KeyCode
	if key == Enum.KeyCode.W or key == Enum.KeyCode.A or key == Enum.KeyCode.S or key == Enum.KeyCode.D or key == Enum.KeyCode.LeftShift then held[key] = true end
	if key == Enum.KeyCode.Q or key == Enum.KeyCode.E then
		if #queue < Rules.MaxQueue then table.insert(queue, key == Enum.KeyCode.Q and "fire" or "lightning") end
		refreshSpell()
	elseif key == Enum.KeyCode.C then table.clear(queue); refreshSpell()
	elseif input.UserInputType == Enum.UserInputType.MouseButton1 or key == Enum.KeyCode.F then
		castSelection()
	end
end)
UserInputService.InputEnded:Connect(function(input) held[input.KeyCode] = nil end)
UserInputService.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement then
		yaw -= input.Delta.X * 0.0022
		pitch = math.clamp(pitch - input.Delta.Y * 0.0022, -1.28, 1.28)
	end
end)

RunService:BindToRenderStep("RiftboundBodycam", Enum.RenderPriority.Camera.Value + 1, function(dt)
	if not character or not root or not head or humanoid.Health <= 0 then return end
	-- Roblox's default transparency controller can restore avatar parts during play.
	for _, descendant in ipairs(character:GetDescendants()) do
		if descendant:IsA("BasePart") then descendant.LocalTransparencyModifier = 1 end
	end
	if workspace.CurrentCamera ~= camera then camera = workspace.CurrentCamera; for _, p in ipairs(viewParts) do p.Parent = camera end end
	UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
	UserInputService.MouseIconEnabled = false
	camera.CameraType = Enum.CameraType.Scriptable
	local forward = Vector3.new(-math.sin(yaw), 0, -math.cos(yaw))
	local right = Vector3.new(math.cos(yaw), 0, -math.sin(yaw))
	local movement = forward * ((held[Enum.KeyCode.W] and 1 or 0) - (held[Enum.KeyCode.S] and 1 or 0)) + right * ((held[Enum.KeyCode.D] and 1 or 0) - (held[Enum.KeyCode.A] and 1 or 0))
	if movement.Magnitude > 1 then movement = movement.Unit end
	humanoid.WalkSpeed = held[Enum.KeyCode.LeftShift] and 23 or 15
	humanoid:Move(movement, false)
	root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, yaw, 0)
	local moving = movement.Magnitude > 0.1
	stride += dt * (moving and (held[Enum.KeyCode.LeftShift] and 13 or 9) or 2)
	castKick = math.max(0, castKick - dt * 4.5)
	local bob = moving and math.sin(stride) * 0.08 or 0
	local sway = moving and math.sin(stride * 0.5) * 0.012 or 0
	local headPosition = head.Position + Vector3.new(0, 0.08 + bob, 0)
	camera.CFrame = CFrame.new(headPosition) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(pitch - castKick * 0.055, 0, sway)
	camera.Focus = camera.CFrame * CFrame.new(0, 0, -20)
	camera.FieldOfView += ((held[Enum.KeyCode.LeftShift] and 86 or 79) - camera.FieldOfView) * math.min(1, dt * 7)
	local cf = camera.CFrame
	local armSwing = math.sin(stride) * (moving and 0.15 or 0.025)
	leftArm.CFrame = cf * CFrame.new(-0.96, -1.4 + armSwing + castKick * 0.25, -2.15) * CFrame.Angles(-0.75 - castKick * 0.45, 0, -0.24)
	rightArm.CFrame = cf * CFrame.new(0.96, -1.46 - armSwing, -2.05) * CFrame.Angles(-0.6, 0, 0.21)
	leftHand.CFrame = leftArm.CFrame * CFrame.new(0, 0.7, 0)
	rightHand.CFrame = rightArm.CFrame * CFrame.new(0, 0.7, 0)
	staff.CFrame = cf * CFrame.new(1.08, -1.22 - armSwing, -3.05) * CFrame.Angles(math.rad(14), 0, math.rad(12))
	staffTip.CFrame = staff.CFrame * CFrame.new(0, 0, -1.15)
	clock.Text = string.format("● REC  %02d:%02d", math.floor(workspace.DistributedGameTime / 60), math.floor(workspace.DistributedGameTime % 60))
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="10">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="Gravity">196.2</float>
      <bool name="NeedsPivotMigration">false</bool>
    </Properties>
  </Item>
</roblox>